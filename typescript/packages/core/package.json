{
  "name": "@microsoft/agent-framework",
  "version": "1.0.0-beta.1",
  "description": "Microsoft Agent Framework for building AI Agents with TypeScript/JavaScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "ai",
    "microsoft",
    "agent-framework",
    "openai",
    "azure",
    "typescript",
    "javascript"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/agent-framework.git",
    "directory": "typescript/packages/core"
  },
  "homepage": "https://github.com/microsoft/agent-framework/tree/main/typescript",
  "bugs": {
    "url": "https://github.com/microsoft/agent-framework/issues"
  },
  "dependencies": {
    "@azure/identity": "^4.6.0",
    "@azure/openai": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.29.0",
    "@opentelemetry/semantic-conventions": "^1.29.0",
    "openai": "^4.76.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "tsup": "^8.3.5",
    "typescript": "~5.8.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
